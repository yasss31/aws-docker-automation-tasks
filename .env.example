# =========================================================
# AWS CONFIGURATION
# =========================================================

AWS_REGION=us-east-1

# Isi dengan kredensial aktif Anda (misal dari AWS Academy / Vocareum Details)
# JANGAN commit file .env asli ke Git!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# =========================================================
# EC2 CONFIGURATION
# =========================================================

# Kosongkan agar script otomatis mencari Ubuntu 24.04 LTS x86_64 terbaru
EC2_AMI_ID=
EC2_AMI_ARCHITECTURE=x86_64
EC2_INSTANCE_TYPE=t3.small
EC2_KEY_NAME=vockey

# Nama IAM Instance Profile, harus sesuai persis di akun AWS Anda
EC2_IAM_INSTANCE_PROFILE=LabInstanceProfile

# =========================================================
# NETWORK CONFIGURATION
# =========================================================

# Kosongkan agar script otomatis menggunakan Default VPC & Subnet
VPC_ID=
SUBNET_ID=

# Jika SECURITY_GROUP_ID kosong, script akan mencari atau membuat satu SG bernama SECURITY_GROUP_NAME
SECURITY_GROUP_ID=
SECURITY_GROUP_NAME=lkpd-docker-sg

# =========================================================
# SECURITY GROUP RULES (Format: PORT:CIDR, dipisah koma)
# =========================================================

SG_RULES=22:0.0.0.0/0,80:0.0.0.0/0,443:0.0.0.0/0,7070:0.0.0.0/0,8080:0.0.0.0/0,8083:0.0.0.0/0,8001:0.0.0.0/0,8002:0.0.0.0/0,8088:0.0.0.0/0,3306:0.0.0.0/0

# =========================================================
# PROJECT
# =========================================================

PROJECT_NAME=aws-lkpd-automation
KEEP_INSTANCES=true

# =========================================================
# APPLICATION - LKPD 2
# =========================================================

APP_REPOSITORY=https://github.com/paknux/apptoko.git
APP_BRANCH=

# =========================================================
# DOCKER HUB - LKPD 4
# =========================================================

DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_REPOSITORY=ubuntu-ws
DOCKERHUB_TAG=v1
DOCKERHUB_SKIP_PUSH=false

# =========================================================
# EXECUTION TIMEOUTS (Detik)
# =========================================================

EXECUTION_MODE=user_data
INSTANCE_TIMEOUT_SECONDS=600
WORKFLOW_TIMEOUT_SECONDS=1800
